# ============================================================
# eating-medication 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ===== 基础配置 =====
APP_NAME=老年人用药管理系统
DEBUG=false
API_V1_PREFIX=/api/v1
PATH_PREFIX=
SERVER_HOST=0.0.0.0
SERVER_PORT=1059

# ===== 数据库 =====
# SQLite（默认）: sqlite:///./data/elderly_care.db
# MySQL: mysql+pymysql://user:password@host:3306/dbname
# PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/elderly_care.db

# ===== 安全 =====
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== Cloudflare Turnstile 人机验证 =====
# 获取: https://dash.cloudflare.com/ -> Turnstile -> 站点 -> Keys
TURNSTILE_SECRET_KEY=

# ===== AI 健康助手（可选，用户也可在子女端单独配置） =====
# ZHIPUAI_API_KEY=
# ZHIPUAI_MODEL=glm-4.7-flash

# ===== 图片 OCR 识别（可选） =====
# 可选值: baidu / tencent / aliyun（留空则禁用）
OCR_PROVIDER=
OCR_API_KEY=
OCR_SECRET_KEY=

# ===== CORS 跨域白名单 =====
# 生产环境必填，填前端访问域名，逗号分隔
ALLOWED_ORIGINS=

# ===== GitHub OAuth 登录（可选） =====
# 申请: https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
FAMILY_WEB_URL=

# ===== Gitee OAuth 登录（可选） =====
# 申请: https://gitee.com/oauth/applications
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
GITEE_OAUTH_CALLBACK_URL=

# ===== 邮件服务（可选） =====
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=老年人用药管理系统
MAIL_TLS=true
MAIL_SSL=false

# ===== 子女端（family_monitor）=====
# 以下变量在 family_monitor/.env 中配置
# SERVER_HOST=0.0.0.0
# SERVER_PORT=4430
# ELDERLY_SERVER_URL=http://localhost:1059
# PATH_PREFIX=
# DISPLAY_THEME=light
# DISPLAY_COLOR=purple
# DISPLAY_LANGUAGE=zh-CN
# DISPLAY_ANIMATIONS=true
# DISPLAY_COMPACT=false
# PRODUCTION=false
# DEVICE_SECRET=
# TURNSTILE_SITE_KEY=
# COOKIE_SECURE=true
