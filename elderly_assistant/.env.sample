# 老人端配置（扁平 .env，与 server / family_monitor 统一）
# 首次运行自动生成，可手动修改；修改后重启生效

# ===== 服务端地址 =====
SERVER_BASE_URL=https://my-website.ccwu.cc/eating-medication/server
SERVER_UPLOAD_ENDPOINT=/api/v1/public/device/upload
SERVER_TIMEOUT=10
HEARTBEAT_INTERVAL=30

# ===== 热点配网 =====
HOTSPOT_SSID=M10-Config
HOTSPOT_IP=10.0.0.1
HOTSPOT_WEB_PORT=8088

# ===== 提醒 =====
# POLL_INTERVAL: 用药计划轮询间隔（秒），默认 60 = 1 分钟
# 缩短间隔可让新设置的用药提醒尽快被设备拉取并在约定时间触发
POLL_INTERVAL=60
BUZZER_LOOP_INTERVAL=3
LONG_PRESS_SEC=1.5

# ===== 摄像头 =====
# CAMERA_CONNECTION: I2C/UART 连接方式（仅供条码/人脸识别使用，图传走网络）
CAMERA_CONNECTION=i2c
CAMERA_UART_TTY=/dev/ttyS1
CAMERA_UART_BAUDRATE=115200
CAMERA_SAVE_PATH=data/captures
# CAMERA_PHOTO_RESOLUTION: 拍照分辨率 default/640x480/1280x720/1920x1080（兼容回退模式）
CAMERA_PHOTO_RESOLUTION=default
# CAMERA_SD_SEARCH_PATHS: 二哈 SD 卡挂载根目录候选，逗号分隔；留空用内置默认（兼容回退模式）
CAMERA_SD_SEARCH_PATHS=

# ===== 网络图传（v2.43.0 新增）=====
# HUSKYLENS_IP: 二哈 V2 的局域网 IP 地址（必填，M10 与二哈需在同一 WiFi 下）
# 获取方式：查看二哈 Web 管理页面或路由器 DHCP 客户端列表
HUSKYLENS_IP=
# HUSKYLENS_NETWORK_MODE: auto=先 HTTP 后 RTSP；http=仅 HTTP；rtsp=仅 RTSP
HUSKYLENS_NETWORK_MODE=auto
# HUSKYLENS_HTTP_PORT: 二哈 HTTP 服务端口（默认 80）
HUSKYLENS_HTTP_PORT=80
# HUSKYLENS_SNAPSHOT_PATH: HTTP 快照接口路径
HUSKYLENS_SNAPSHOT_PATH=/snapshot
# HUSKYLENS_STREAM_PATH: HTTP MJPEG 流接口路径
HUSKYLENS_STREAM_PATH=/stream
# HUSKYLENS_RTSP_PORT: RTSP 端口（默认 554）
HUSKYLENS_RTSP_PORT=554
# HUSKYLENS_REQUEST_TIMEOUT: HTTP 请求超时（秒）
HUSKYLENS_REQUEST_TIMEOUT=5
# HUSKYLENS_WEBRTC_OFFER_PATH: WebRTC SDP offer 信令接口路径
HUSKYLENS_WEBRTC_OFFER_PATH=/webrtc/offer

# ===== 药品条码扫描 =====
# SCAN_SOURCE: auto=优先 HuskyLens 板载解码并回退 USB；可选 huskylens / usb
SCAN_SOURCE=auto
SCAN_USB_INDEX=0
SCAN_TIMEOUT_SEC=8

# ===== 音频 / 语音 =====
# EDGE_TTS_VOICE: edge-tts 音色；EDGE_TTS_RATE: 语速（+0% 正常，+50% 加快，-30% 放慢）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
# PLAYER_PRECEDENCE: 播放器探测优先级（逗号分隔）；Linux 端检测不到时自动 apt 安装 mpg123
PLAYER_PRECEDENCE=mpg123,ffplay,mpv,play
# TTS_CACHE_DIR: edge-tts 合成文件本地缓存目录（相对 BASE_DIR 或绝对路径）；命中索引直接播放
TTS_CACHE_DIR=data/tts_cache
